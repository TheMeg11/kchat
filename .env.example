# Copy to .env locally, or set Railway Variables. NEVER commit real secrets.
# Railway must use persistent PostgreSQL; local default can use SQLite.
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db

TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=
# Bale wallet provider token; leave empty to disable Bale payments.
BALE_PROVIDER_TOKEN=
# Optional private delivery bot for generated one-time panel credentials.
DELIVERY_BOT_TOKEN=

# Generate THREE independent values, e.g. secrets.token_urlsafe(32).
# All must be >=24 characters on Railway. Preserve backup keys externally.
ENCRYPTION_KEY=
BACKUP_PASSWORD=
WEBHOOK_SECRET=
# Explicit HTTPS origin; when blank on Railway, uses RAILWAY_PUBLIC_DOMAIN.
# Enable a public domain in Railway Networking if neither is configured.
PUBLIC_URL=

# Explicit comma-separated numeric IDs. Do not use someone else's defaults.
ADMIN_TELEGRAM_IDS=
ADMIN_BALE_IDS=
BACKUP_OWNER_TELEGRAM_ID=
# ONE-TIME bootstrap, never reconciles/resets an existing changed password.
ADMIN_PANEL_USERNAME=
ADMIN_PANEL_PASSWORD=

# Single process / single replica only. See docs/DEPLOYMENT.md.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
UPDATE_WORKERS=2
UPDATE_MAX_ATTEMPTS=8
SESSION_DAYS=30
# Automatically secure on Railway; true for other HTTPS deployments.
COOKIE_SECURE=false
# Trust forwarded IP headers ONLY from explicitly trusted ingress proxy IPs.
# Empty = no trusted forwarded address; confirm Railway proxy topology first.
TRUSTED_PROXY_IPS=

WEBHOOK_MAX_BYTES=262144
RESTORE_MAX_BYTES=67108864
RESTORE_EXPANDED_MAX_BYTES=33554432
BACKUP_MAX_BYTES=67108864
CROSS_MEDIA_MAX_BYTES=20971520
# Backup delivery uses fixed 18 MiB parts, independent of media chunk settings.
# Do not set RESTORE_ON_BOOT_FILE except during explicit operator recovery.
