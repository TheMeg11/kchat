# ---- Kanar Anonymous Chat — environment template ----
# Copy to .env (local) or set as Railway Variables (production).
# NEVER commit real secrets.

# PostgreSQL (Railway provides DATABASE_URL automatically when a Postgres
# service is attached; for local dev SQLite is used by default).
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db

# Platform bots
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=
# Wallet payment token from Bale @BotFather ("پرداخت در بازوها") — REQUIRED to
# enable Bale wallet payments (sendInvoice). Leave empty to keep Bale payments
# disabled. Obtain it: Bale @BotFather -> your bot -> "پرداخت در بازوها".
BALE_PROVIDER_TOKEN=
# Separate delivery bot used ONLY for one-time credential/backup-password delivery
DELIVERY_BOT_TOKEN=

# Secrets (generate with: python -c "import secrets;print(secrets.token_urlsafe(32))")
ENCRYPTION_KEY=
BACKUP_PASSWORD=
WEBHOOK_SECRET=

# Public HTTPS URL of this service (required for webhook mode; without it the
# app falls back to long polling).
PUBLIC_URL=

# Owner identifiers (independent per platform; multiple IDs: comma separated)
ADMIN_TELEGRAM_IDS=860835914
ADMIN_BALE_IDS=133609405

# Backup delivery target for the daily 03:00 Asia/Tehran encrypted backup
BACKUP_OWNER_TELEGRAM_ID=860835914
